# Python
__pycache__/
*.py[cod]
*.so
.Python

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
.env
.env.*
!.env.example

# Credential files. The project takes secrets from the environment only, so
# none of these should exist; the guard is for the day one is made by hand.
credentials.json
*.credentials.json
*.pem

# Tooling caches
.cache/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
site/

# Editors / OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store

# Agent local state — shared config IS committed, personal overrides are not
.claude/settings.local.json
.claude/tmp/
CLAUDE.local.md
.codex/config.local.toml

# Local databases and scan exports. The SQLite default in .env.example writes
# here; nothing about a local scan belongs in version control.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/eligible_stocks.csv

# Rescued API dumps from a deleted database — local artefacts, not source.
/rescue-*/

# Output of commands the dashboard started. One file per job.
.jobs/

# Operational control state. Carries account binding fingerprints, kill state,
# incidents and soak evidence — all specific to one operator's paper account,
# and none of it repository content. A committed kill switch would also be a
# kill switch somebody else's checkout inherits.
.operations/

# A local SEC evidence control plane (SEC_CONTROL_DIR=.evidence): runtime
# manifests, checkpoints, plans and the derived index. Never committed.
.evidence/

# Portfolio ledgers, checkpoints and reconciliation reports: operational
# trading records, never repository content.
.portfolio/
