# Copy to `.env` for local development. Never commit `.env`.
# Every variable here must have a matching typed field in src/stock_screener/config.py.
#
# Placeholder values only. Real credentials go in `.env`, which is gitignored.

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite runs with no setup and is the default. PostgreSQL is the intended
# production database:
#   DATABASE_URL=postgresql+psycopg://radar:radar@localhost:5432/compounder_radar
DATABASE_URL=sqlite:///./compounder_radar.db

# ---------------------------------------------------------------------------
# Providers
# ---------------------------------------------------------------------------
# `mock` reads FIXTURE_PATH and needs no credentials, so a fresh clone runs the
# whole pipeline. Switch to a real provider once its keys are set below.
MARKET_DATA_PROVIDER=mock
# mock | edgar | edgar+fmp | fmp
#   edgar is enough to scan and rank the whole market: statements from SEC XBRL,
#   a market cap calculated from the cover-page share count and the latest close,
#   and an SIC industry. Free, and covers every U.S. filer.
#   edgar+fmp adds FMP's vendor market cap and consolidated volume. Those are
#   metered, so they are spent on top candidates by `enrich`, not on the scan.
FUNDAMENTALS_PROVIDER=mock
FIXTURE_PATH=fixtures/sample_universe.json

# Required whenever the provider involves EDGAR. The SEC blocks requests that do
# not identify the caller; name the application and a real contact address.
SEC_USER_AGENT=

# Required when MARKET_DATA_PROVIDER=alpaca.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper-trading keys (they begin `PK`) must use the paper host, or the asset
# list returns 401. Live keys begin `AK` and use api.alpaca.markets.
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
# `sip` is the consolidated tape and needs a paid data plan. `iex` is what a
# free account can read — prices are sound, but volume is only that one
# exchange's share (~2-4% of consolidated), so the liquidity filter will
# exclude companies that genuinely trade above the threshold.
ALPACA_FEED=iex

# Required when FUNDAMENTALS_PROVIDER=fmp.
FUNDAMENTALS_API_KEY=
FUNDAMENTALS_BASE_URL=https://financialmodelingprep.com
# FMP retired /api/v3 for keys issued after the stable API launched.
FUNDAMENTALS_API_ROOT=/stable

# ---------------------------------------------------------------------------
# Provider behaviour
# ---------------------------------------------------------------------------
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_BACKOFF_SECONDS=1.0
PROVIDER_MIN_REQUEST_INTERVAL_SECONDS=0.2
PROVIDER_BATCH_SIZE=100
PROVIDER_TIMEOUT_SECONDS=30.0

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
# 400 days covers a 52-week high and a 12-month return with room for holidays.
PRICE_HISTORY_DAYS=400
# 16 quarters are the minimum for a three-year revenue CAGR, 6 for growth
# acceleration. Metered plans cap this and reject anything larger outright —
# FMP's free tier allows 5, which is enough for YoY growth and margins but not
# for acceleration, TTM growth or the CAGR. Set it to what your plan allows.
FUNDAMENTALS_QUARTERS=20

# ---------------------------------------------------------------------------
# Scoring
# ---------------------------------------------------------------------------
# The broad-market series relative strength is measured against, fetched through
# the market-data provider by `update-benchmark`. Changing it changes what every
# momentum score means, so re-score the market rather than comparing across two.
BENCHMARK_SYMBOL=SPY
# How many top-ranked candidates the enrichment pass may spend metered requests
# on. The broad scan runs on Alpaca + EDGAR and needs none; enrichment buys a
# vendor market cap and consolidated volume for the companies a ranking shows.
# Set it to what your plan's daily allowance can actually serve.
FMP_ENRICHMENT_LIMIT=200

# ---------------------------------------------------------------------------
# AI research (Phase 3)
# ---------------------------------------------------------------------------
# Which model writes research reports. `mock` returns a canned draft and calls
# nothing — the brief, the validation and the persistence all still run, so the
# pipeline is exercisable with no credentials and no cost.
RESEARCH_PROVIDER=mock
# Credential for the research provider. Required unless RESEARCH_PROVIDER=mock.
RESEARCH_API_KEY=
# Model identifier, stored on every report. A report written by one model is not
# evidence about what another would have said.
RESEARCH_MODEL=claude-sonnet-5
# Ceiling on one report's generated tokens. On a thinking model this covers the
# reasoning as well as the thirteen sections.
RESEARCH_MAX_OUTPUT_TOKENS=8000
# How hard the model works per report: low, medium or high. This is the
# determinism and cost lever — current Claude models reject `temperature`, so a
# low sampling temperature is not expressible.
RESEARCH_EFFORT=medium
# Per-request timeout, in seconds.
RESEARCH_TIMEOUT_SECONDS=120
# Estimated spend allowed in one research run, in US dollars. The run stops
# before the request that could cross it, and keeps everything already stored.
RESEARCH_MAX_RUN_COST_USD=5.0

# ---------------------------------------------------------------------------
# Eligibility thresholds
# ---------------------------------------------------------------------------
# The Phase 1 defaults. These are the numbers to tune during manual review.
MIN_PRICE=2.0
MIN_MARKET_CAP=100000000
MIN_AVG_DOLLAR_VOLUME=1000000
# Sessions of price history required before the liquidity figure counts.
MIN_TRADING_DAYS=20
